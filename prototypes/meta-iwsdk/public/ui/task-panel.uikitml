<style>
  .panel-root {
    flex-direction: column;
    width: 80;
    height: 100;
    max-height: 100;
    overflow: hidden;
    padding-top: 3.5;
    padding-right: 4;
    padding-bottom: 3.5;
    padding-left: 4;
    gap: 1.6;
    background-color: #fffaf0;
    border-color: #ef9f2f;
    border-width: 0.6;
    border-radius: 4;
  }

  .grab-handle {
    width: 100%;
    min-height: 10;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 2;
    background-color: #ffe4b3;
    font-size: 2.3;
    font-weight: 700;
    color: #713f08;
  }

  .brand-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 2;
    width: 100%;
  }

  .settings-toggle {
    width: 10;
    height: 10;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 2;
    background-color: #fef3c7;
  }

  .brand {
    font-size: 4.2;
    font-weight: 700;
    color: #17130f;
  }

  .mode {
    padding-top: 0.6;
    padding-right: 1.4;
    padding-bottom: 0.6;
    padding-left: 1.4;
    border-radius: 2;
    background-color: #ffe4b3;
    font-size: 2.1;
    font-weight: 600;
    color: #96550c;
  }

  .eyebrow {
    font-size: 2.1;
    font-weight: 700;
    color: #96550c;
  }

  .task-card {
    flex-direction: column;
    justify-content: center;
    min-height: 15;
    width: 100%;
    padding-top: 2.5;
    padding-right: 3.5;
    padding-bottom: 2.5;
    padding-left: 3.5;
    border-radius: 2.5;
    background-color: #24201b;
  }

  .task-text {
    width: 100%;
    font-size: 3.5;
    font-weight: 700;
    line-height: 1.2;
    color: #ffffff;
    text-align: center;
  }

  .summary-row {
    flex-direction: row;
    width: 100%;
    gap: 1.5;
  }

  .summary-item {
    flex-grow: 1;
    flex-shrink: 1;
    width: 34;
    min-width: 0;
    padding-top: 0.8;
    padding-right: 1;
    padding-bottom: 0.8;
    padding-left: 1;
    border-radius: 1.5;
    background-color: #f3ebdd;
    font-size: 2.2;
    font-weight: 600;
    color: #5c5143;
    text-align: center;
  }

  .waiting {
    font-weight: 700;
    color: #96550c;
    background-color: #fff0d5;
  }

  .label {
    width: 100%;
    font-size: 2.2;
    font-weight: 600;
    color: #332d25;
  }

  .task-controls {
    flex-shrink: 0;
    flex-direction: column;
    width: 100%;
    gap: 1.7;
  }

  .input {
    width: 0;
    min-width: 0;
    flex-grow: 1;
    height: 10;
    font-size: 2.6;
    color: #332d25;
  }

  .entry-row {
    flex-direction: row;
    width: 100%;
    align-items: center;
    gap: 1.5;
  }
  .entry-done {
    width: 14;
    height: 10;
    justify-content: center;
    border-radius: 2;
    background-color: #d97706;
    color: #ffffff;
    font-size: 2.6;
    font-weight: 700;
  }

  .action-row {
    flex-direction: row;
    width: 100%;
    gap: 2;
  }

  .action {
    flex-grow: 1;
    flex-shrink: 1;
    width: 34;
    min-width: 0;
    max-width: 34;
    height: 10;
    justify-content: center;
    background-color: #efe7d8;
    border-radius: 2;
    font-size: 2.6;
    font-weight: 700;
    color: #332d25;
    text-align: center;
  }

  .complete {
    background-color: #d97706;
    color: #ffffff;
  }

  .status {
    width: 100%;
    min-height: 5;
    padding-top: 0.8;
    padding-right: 1.5;
    padding-bottom: 0.8;
    padding-left: 1.5;
    justify-content: center;
    border-radius: 2;
    background-color: #f3ebdd;
    font-size: 2.2;
    font-weight: 700;
    color: #5c5143;
    text-align: center;
  }

  .new-list-button {
    width: 100%;
    height: 10;
    justify-content: center;
    border-width: 0.6;
    border-color: #d97706;
    border-radius: 2;
    background-color: #fff0d5;
    font-size: 2.5;
    font-weight: 700;
    color: #713f08;
    text-align: center;
  }

  .new-list-review {
    flex-direction: column;
    width: 100%;
    padding-top: 2;
    padding-right: 2;
    padding-bottom: 2;
    padding-left: 2;
    gap: 1.4;
    border-width: 0.6;
    border-color: #d97706;
    border-radius: 2;
    background-color: #fff0d5;
  }

  .review-title {
    width: 100%;
    font-size: 2.7;
    font-weight: 700;
    color: #332d25;
    text-align: center;
  }

  .review-copy {
    width: 100%;
    font-size: 2.1;
    line-height: 1.25;
    color: #5c5143;
    text-align: center;
  }

  .carry-button {
    width: 100%;
    min-height: 10;
    padding-right: 2;
    padding-left: 2;
    justify-content: center;
    border-radius: 2;
    background-color: #d97706;
    font-size: 2.2;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
  }

  .review-actions {
    flex-direction: row;
    width: 100%;
    gap: 1.5;
  }

  .review-action {
    flex-grow: 1;
    flex-shrink: 1;
    width: 33;
    min-width: 0;
    height: 10;
    justify-content: center;
    border-radius: 2;
    background-color: #24201b;
    font-size: 2.2;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
  }

  .cancel-action {
    background-color: #efe7d8;
    color: #332d25;
  }

  .xr-row {
    flex-direction: row;
    justify-content: center;
    width: 100%;
  }

  .small-button {
    width: 100%;
    height: 10;
    justify-content: center;
    background-color: #24201b;
    border-radius: 2;
    font-size: 2.5;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
  }
</style>
<Panel id="panel-surface" class="panel-root">
  <button id="grab-handle" class="grab-handle">Pinch here to move</button>
  <div class="brand-row">
    <div style="flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0">
      <div style="flex-direction: row; align-items: flex-start"><span class="brand">CueDone</span><span style="font-size: 1.8; font-weight: 700; color: #17130f">TM</span></div>
      <div style="flex-direction: row; align-items: center; gap: 0.8"><div style="width: 2.5; height: 0.2; background-color: #96550c"></div><span class="eyebrow">See it. Do it. CueDone.</span></div>
    </div>
    <button id="collapse-toggle" class="settings-toggle"></button>
    <button id="settings-toggle" class="settings-toggle"></button>
  </div>
  <div id="panel-body" style="flex-grow: 1; flex-shrink: 1; min-height: 0; overflow: scroll; flex-direction: column; width: 100%; gap: 1.6">
  <div id="body-content" style="flex-shrink: 0; flex-direction: column; width: 100%; gap: 1.6">
  <span class="eyebrow">TO-DO LIST</span>
  <div id="task-list" style="flex-direction: column; width: 100%; flex-shrink: 0; max-height: 64; overflow: scroll; gap: 1"></div>
  <div class="task-card" style="display: none">
    <span id="task-text" class="task-text">Loading...</span>
  </div>
  <div class="summary-row">
    <span id="progress-text" class="summary-item">0 of 0 complete</span>
    <span id="waiting-text" class="summary-item waiting">0 tasks waiting</span>
  </div>
  <div class="action-row">
    <button id="reset-button" class="action">Reset</button>
    <button id="clear-button" class="action">Clear All</button>
    <button id="show-add-button" class="action">Add Task</button>
  </div>

  <span id="status-text" class="status">Loading your local list...</span>
  <button id="new-list-button" class="new-list-button">New List</button>
  <div id="new-list-review" class="new-list-review" style="display: none">
    <span id="new-list-title" class="review-title">Start a new list?</span>
    <span id="new-list-copy" class="review-copy">
      Completed tasks will not carry forward.
    </span>
    <button id="carry-button" class="carry-button">
      Carry unfinished tasks forward
    </button>
    <div class="review-actions">
      <button id="empty-button" class="review-action">Start empty</button>
      <button id="cancel-new-list" class="review-action cancel-action">
        Cancel
      </button>
    </div>
  </div>
  <button id="retry-button" class="small-button" style="display: none">
    Retry loading
  </button>
  <div id="settings-panel" style="display: none; flex-direction: column; width: 100%; gap: 1.4">
  <button id="spatial-scale" class="new-list-button">Panel size: Standard</button>
  <div class="action-row">
    <button id="spatial-placement" class="action">Panel: Head relative</button>
    <button id="spatial-motion" class="action">Ambient motion: On</button>
  </div>
  <button id="spatial-sound" class="new-list-button">Garden sound: Off</button>
  <button id="spatial-recenter" class="new-list-button">Recenter to face</button>
  <button id="spatial-retry" class="small-button" style="display: none">Retry appearance</button>
  <span id="spatial-input-status" class="review-copy">Hands only: aim and pinch, or touch.</span>
  <span id="spatial-status" class="review-copy">Stay seated or within your Quest boundary.</span>
  </div>
  <div class="xr-row">
    <button id="xr-button" class="small-button">Enter AR</button>
    <button id="exit-button" class="small-button" style="display: none">
      Exit AR
    </button>
  </div>
  </div>
  </div>
  <div id="scroll-controls" class="action-row" style="flex-shrink: 0">
    <button id="scroll-up" class="action">Scroll up</button>
    <button id="scroll-down" class="action">Scroll down</button>
  </div>
  <div id="task-controls" class="task-controls" style="display: none">
    <span class="label">Add a task</span>
    <div class="entry-row">
    <Input
      id="task-input"
      class="input"
      placeholder="Type a short task"
    ></Input>
      <button id="entry-done-button" class="entry-done">Done</button>
    </div>
    <span class="review-copy">Enter adds a task. Done finishes.</span>
    <button id="complete-button" class="action complete" style="display: none">Complete</button>
  </div>
  <button id="done-button" class="carry-button" style="display: none">Done</button>
</Panel>
